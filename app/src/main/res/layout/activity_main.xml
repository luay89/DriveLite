<?xml version="1.0" encoding="utf-8"?>
<!-- Left column | Clock & date | Right column. Flat hierarchy, no images, no animations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <include android:id="@+id/tile_maps" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include android:id="@+id/tile_radio" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include android:id="@+id/tile_phone" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.35"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="140sp"
            android:autoSizeMinTextSize="40sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM yyyy"
            android:format24Hour="EEEE, d MMMM yyyy"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/home_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="@string/banner_set_home"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <include android:id="@+id/tile_music" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include android:id="@+id/tile_apps" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <include android:id="@+id/tile_settings" layout="@layout/tile"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
